# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/

# Generated platform scaffolding. This is a pure Dart package: it has no
# platform code of its own, so anything Flutter generates at the package root
# is a build artifact, not a source file. (Scoped to the root so the example
# app keeps its own platform folders.)
/android/
/ios/
/linux/
/macos/
/windows/
/local.properties
